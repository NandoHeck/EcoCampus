# =============================================================================
# EcoCampus — variáveis de ambiente
# Copie para `.env` e ajuste conforme o ambiente. Nunca comite o .env.
# =============================================================================

# Porta em que o backend escuta. Em produção (Render), a porta é definida
# automaticamente pela plataforma via a variável PORT.
PORT=3333

# Host de bind. 0.0.0.0 é obrigatório em containers (Render, Railway, Fly).
HOST=0.0.0.0

# Origem permitida em CORS.
#   Local: use * (permite Live Server e outros).
#   Produção: restrinja para o domínio exato do seu frontend, ex.:
#     CORS_ORIGIN=https://ecocampus.netlify.app
CORS_ORIGIN=*

# Salt usado no hash de senhas (SHA-256 + salt).
# Em produção, o Render gera automaticamente via `render.yaml` (generateValue: true).
# Nunca versione o valor real de produção.
PASSWORD_SALT=troque-me-em-producao

# Driver de persistência:
#   sqlite (default) — usa `better-sqlite3` e persiste em `backend/data/ecocampus.db`
#   json             — usa arquivo JSON em `backend/data/db.json`
# Se DB_DRIVER=sqlite mas `better-sqlite3` não puder ser instalado (ex.: Node muito
# novo sem prebuild + sem toolchain nativo local), o backend cai automaticamente
# para JSON com um warning. Em produção (Render + Node 20) o SQLite instala normalmente.
DB_DRIVER=sqlite

# Caminho customizado dos arquivos de persistência (opcional).
# Deixe em branco para usar os defaults acima.
# DB_PATH_SQLITE=/opt/render/project/src/data/ecocampus.db
# DB_PATH_JSON=/opt/render/project/src/data/db.json
