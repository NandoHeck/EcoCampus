{
  "name": "ecocampus",
  "version": "1.0.0",
  "private": true,
  "description": "EcoCampus — Marketplace de economia circular universitária (Frontend HTML/CSS/JS + Backend Node/Express).",
  "scripts": {
    "install:backend": "npm install --prefix backend",
    "postinstall": "npm install --prefix backend",
    "start": "node backend/server.js",
    "dev": "node --watch backend/server.js",
    "seed": "node backend/src/infrastructure/seed/seed.js",
    "icons": "node scripts/generate-icons.js",
    "set-api": "node scripts/set-api-url.js"
  },
  "devDependencies": {
    "sharp": "^0.33.5"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "marketplace",
    "universidade",
    "economia-circular",
    "estudantes"
  ],
  "author": "EcoCampus"
}
